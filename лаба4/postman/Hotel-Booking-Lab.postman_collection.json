  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "function localDay(offset) {",
          "  const d = new Date();",
          "  d.setMinutes(d.getMinutes() - d.getTimezoneOffset());",
          "  d.setUTCDate(d.getUTCDate() + offset);",
          "  return d.toISOString().slice(0, 10);",
          "}",
          "pm.collectionVariables.set('checkInDate', localDay(0));",
          "pm.collectionVariables.set('checkOutDate', localDay(2));",
          "pm.collectionVariables.set('extensionCheckOutDate', localDay(4));",
          "pm.collectionVariables.set('crudCheckInDate', localDay(10));",
          "pm.collectionVariables.set('crudCheckOutDate', localDay(12));",
          "pm.collectionVariables.set('cancelCheckInDate', localDay(20));",
          "pm.collectionVariables.set('cancelCheckOutDate', localDay(22));",
          "pm.collectionVariables.set('overlapStartDate', localDay(30));",
          "pm.collectionVariables.set('overlapEndDate', localDay(32));",
          "pm.collectionVariables.set('conflictStartDate', localDay(31));",
          "pm.collectionVariables.set('conflictEndDate', localDay(33));",
          "if (pm.info.requestName === 'Создать основного клиента') pm.collectionVariables.set('customerEmail', 'ekaterina.' + Date.now() + '@example.com');",
          "if (pm.info.requestName === 'Создать клиента для проверки DELETE') pm.collectionVariables.set('deleteCustomerEmail', 'temporary.' + Date.now() + '@example.com');",
          "if (pm.info.requestName === 'Создать основной номер') pm.collectionVariables.set('roomNumber', '9' + String(Date.now()).slice(-8));",
          "if (pm.info.requestName === 'Создать номер для проверки DELETE') pm.collectionVariables.set('deleteRoomNumber', '8' + String(Date.now()).slice(-8));"
        ]
      }
    }
  ],

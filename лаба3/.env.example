# Copy this file to .env and change every password before running the project.
POSTGRES_DB=hotel_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_this_admin_password
POSTGRES_PORT=5432

# Used only by Flyway for database migrations. This user is not a superuser.
MIGRATION_DB_USER=hotel_migrator
MIGRATION_DB_PASSWORD=change_this_migration_password

# Used by the REST API at runtime. This user has DML permissions only.
APP_DB_USER=hotel_app
APP_DB_PASSWORD=change_this_app_password
